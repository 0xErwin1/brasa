    cond
      Binary(==)
        Binary(%)
          Ident(n)
          Int(15)
        Int(0)
    then
      StringLit
        Text(raw=false) "FizzBuzz"
    elsif
      Binary(==)
        Binary(%)
          Ident(n)
          Int(3)
        Int(0)
    then
      StringLit
        Text(raw=false) "Fizz"
    elsif
      Binary(==)
        Binary(%)
          Ident(n)
          Int(5)
        Int(0)
    then
