pub FuncDef files(dir)
  Let none
    VectorLit
  Let hits
    VectorLit
  For
    Binding(path)
    Field(paths)
      Call
        Field(tryWalk)
          Ident(fs)
        Ident(dir)
        Ident(none)
    If
      cond
        Call
          Field(endsWith?)
            Ident(path)
          StringLit
            Text(raw=false) ".jsonl"
      then
        Call
          Field(push)
            Ident(hits)
          Ident(path)
  Call
    Field(sort)
      Ident(hits)
