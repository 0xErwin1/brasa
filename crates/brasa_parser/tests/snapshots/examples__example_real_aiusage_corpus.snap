FuncDef scanFile(path, seen, turns)
  Let text
    Catch(exhaustive=false, binding=e)
      Call
        Field(read)
          Ident(fs)
        Ident(path)
      arm _
          StringLit
  For
    Binding(line)
    Call
      Field(lines)
        Ident(text)
    If
      cond
        Unary(!)
          Call
            Field(contains?)
              Ident(line)
            StringLit
              Text(raw=false) "\"type\":\"assistant\""
      then
        Continue
    Let doc
      Catch(exhaustive=false, binding=e)
        Call
          Field(parse)
            Ident(json)
          Ident(line)
        arm json.ParseError
            Call
              Field(parse)
                Ident(json)
              StringLit
                Text(raw=false) "null"
    If
      cond
        Binary(||)
          Binary(!=)
            Coalesce
              Call
                Field(asString)
                  Index
                    Ident(doc)
                    StringLit
                      Text(raw=false) "type"
              StringLit
            StringLit
              Text(raw=false) "assistant"
          Call
            Field(null?)
              Index
                Index
                  Ident(doc)
                  StringLit
                    Text(raw=false) "message"
                StringLit
                  Text(raw=false) "usage"
      then
        Continue
    Let key
      StringLit
        Interp
          Coalesce
            Call
              Field(asString)
                Index
                  Index
                    Ident(doc)
                    StringLit
                      Text(raw=false) "message"
                  StringLit
                    Text(raw=false) "id"
            StringLit
        Text(raw=false) "|"
        Interp
          Coalesce
            Call
              Field(asString)
                Index
                  Ident(doc)
                  StringLit
                    Text(raw=false) "requestId"
            StringLit
    If
      cond
        Binary(&&)
          Binary(!=)
            Ident(key)
            StringLit
              Text(raw=false) "|"
          Call
            Field(has?)
              Ident(seen)
            Ident(key)
      then
        Continue
    Call
      Field(add)
        Ident(seen)
      Ident(key)
    Let stamp
      Catch(exhaustive=false, binding=e)
        Call
          Field(parseIso)
            Ident(time)
          Coalesce
            Call
              Field(asString)
                Index
                  Ident(doc)
                  StringLit
                    Text(raw=false) "timestamp"
            StringLit
        arm time.ParseError
            Int(0)
    If
      cond
        Binary(>)
          Ident(stamp)
          Int(0)
      then
        Call
          Field(push)
            Ident(turns)
          Call
            Ident(turnFrom)
            Ident(doc)
            Ident(stamp)
