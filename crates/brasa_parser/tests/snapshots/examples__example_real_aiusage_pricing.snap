      Int(0)
      Int(1000000)
    Float(1.5)
TestDef("a turn's cost is the sum of its four counters at their own rates")
  Call
    Ident(assertEq)
    Call
      Ident(usd)
      Call
        Ident(forModel)
        StringLit
          Text(raw=false) "claude-opus-5"
      Int(1000000)
      Int(2000000)
      Int(0)
      Int(0)
    Float(165)
