              Field(toFloat)
                Ident(outTok)
            Field(output)
              Ident(p)
        Binary(*)
          Call
            Field(toFloat)
              Ident(writeTok)
          Field(cacheWrite)
            Ident(p)
      Binary(*)
        Call
          Field(toFloat)
            Ident(readTok)
        Field(cacheRead)
          Ident(p)
    Float(1000000)
TestDef("a model id collapses to its tier")
  Call
    Ident(assertEq)
    Call
      Ident(label)
      StringLit
        Text(raw=false) "claude-opus-5"
    StringLit
      Text(raw=false) "Opus"
  Call
    Ident(assertEq)
    Call
      Ident(label)
      StringLit
        Text(raw=false) "CLAUDE-HAIKU-4-5"
    StringLit
      Text(raw=false) "Haiku"
  Call
    Ident(assertEq)
    Call
      Ident(label)
      StringLit
        Text(raw=false) "claude-sonnet-5-20260101"
    StringLit
      Text(raw=false) "Sonnet"
TestDef("an unknown model keeps its raw id rather than hiding in the default")
  Call
    Ident(assertEq)
    Call
      Ident(label)
      StringLit
        Text(raw=false) "some-model-nobody-added-yet"
    StringLit
      Text(raw=false) "some-model-nobody-added-yet"
