pub FuncDef response(dir, name)
  Let text
    Catch(exhaustive=false, binding=e)
      Call
        Field(read)
          Ident(fs)
        Call
          Field(join)
            Ident(fs)
          Ident(dir)
          StringLit
            Interp
              Ident(name)
            Text(raw=false) ".json"
      arm _
          StringLit
  Catch(exhaustive=false, binding=e)
    Call
      Field(parse)
        Ident(json)
      Ident(text)
    arm json.ParseError
        Call
          Field(parse)
            Ident(json)
          StringLit
            Text(raw=false) "null"
pub FuncDef dollars(amountMinor, exponent)
  Let mut div
    Int(1)
  For
    Wildcard
    Range(inclusive=false)
      Int(0)
      Ident(exponent)
    Assign =
      Ident(div)
      Binary(*)
        Ident(div)
        Int(10)
  StringLit
    Text(raw=false) "$"
    Interp
      Call
        Field(toFixed)
          Binary(/)
            Call
              Field(toFloat)
                Ident(amountMinor)
            Call
              Field(toFloat)
                Ident(div)
        Int(2)
