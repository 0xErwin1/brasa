FuncDef entries(dir)
  Let none
    VectorLit
  Catch(exhaustive=false, binding=e)
    Call
      Field(ls)
        Ident(fs)
      Ident(dir)
    arm fs.Denied
        Ident(none)
    arm fs.IoError
        Ident(none)
FuncDef collectLocks(dir, found, depth)
  If
    cond
      Binary(>)
        Ident(depth)
        Ident(maxDepth)
    then
      Return
  Let lock
    Call
      Field(join)
        Ident(fs)
      Ident(dir)
      StringLit
        Text(raw=false) "flake.lock"
  If
    cond
      Call
        Field(isFile?)
          Ident(fs)
        Ident(lock)
    then
      Call
        Field(push)
          Ident(found)
        Ident(lock)
  For
    Binding(name)
    Call
      Ident(entries)
      Ident(dir)
    Let child
      Call
        Field(join)
          Ident(fs)
        Ident(dir)
        Ident(name)
    If
      cond
        Binary(&&)
          Unary(!)
            Call
              Field(has?)
                Ident(pruned)
              Ident(name)
          Call
            Field(isDir?)
              Ident(fs)
            Ident(child)
      then
        Call
          Ident(collectLocks)
          Ident(child)
          Ident(found)
          Binary(+)
            Ident(depth)
            Int(1)
