---
source: crates/brasa_parser/tests/examples.rs
expression: dump
---
Import::Std(std::cli)
Import::Std(std::env)
Import::Std(std::fs)
Import::Std(std::io)
Import::File("tally.bras")
Let spec
  VectorLit
    VectorLit
      StringLit
        Text(raw=false) "option"
      StringLit
        Text(raw=false) "top"
      StringLit
        Text(raw=false) "t"
      StringLit
        Text(raw=false) "how many rows per section (default 5)"
    VectorLit
      StringLit
        Text(raw=false) "flag"
      StringLit
        Text(raw=false) "help"
      StringLit
        Text(raw=false) "h"
      StringLit
        Text(raw=false) "print this help"
    VectorLit
      StringLit
        Text(raw=false) "arg"
      StringLit
        Text(raw=false) "log"
      StringLit
      StringLit
        Text(raw=false) "the access log to read; stdin when omitted"
Let entryPattern
  StringLit
    Text(raw=true) "^(\\S+) \\S+ \\S+ \\[[^\\]]+\\] \"([A-Z]+) ([^ \"]+)[^\"]*\" (\\d{3}) (\\d+|-)"
FuncDef source(rest)
  If
    cond
      Binary(==)
        Call
          Field(len)
            Ident(rest)
        Int(0)
    then
      Call
        Field(readAll)
          Ident(io)
    else
      Call
        Field(read)
          Ident(fs)
        Index
          Ident(rest)
          Int(0)
FuncDef percent(part, total)
  Let share
    Binary(*)
      Binary(/)
        Call
          Field(toFloat)
            Ident(part)
        Call
          Field(toFloat)
            Ident(total)
      Float(100)
  StringLit
    Interp
      Call
        Field(toFixed)
          Ident(share)
        Int(1)
    Text(raw=false) "%"
FuncDef report(title, rows, limit)
  Call
    Ident(puts)
    StringLit
  Call
    Ident(puts)
    Ident(title)
  For
    Binding(row)
    Call
      Field(slice)
        Ident(rows)
      Int(0)
      Ident(limit)
    Call
      Ident(puts)
      StringLit
        Text(raw=false) "  "
        Interp
          Call
            Field(pad)
              Ident(tally)
            Field(hits)
              Ident(row)
            Int(4)
        Text(raw=false) "  "
        Interp
          Field(key)
            Ident(row)
FuncDef main()
  Let args
    Catch(exhaustive=false, binding=e)
      Call
        Field(parse)
          Ident(cli)
        Call
          Field(args)
            Ident(env)
        Ident(spec)
      arm cli.UsageError
          Call
            Field(eprint)
              Ident(io)
            StringLit
              Interp
                Ident(e)
              Text(raw=false) "\n\n"
              Interp
                Call
                  Field(help)
                    Ident(cli)
                  StringLit
                    Text(raw=false) "logstat.bras"
                  Ident(spec)
          Call
            Field(exit)
              Ident(env)
            Int(2)
          Call
            Field(parse)
              Ident(cli)
            VectorLit
            Ident(spec)
  If
    cond
      Call
        Field(flag)
          Ident(args)
        StringLit
          Text(raw=false) "help"
    then
      Call
        Ident(print)
        Call
          Field(help)
            Ident(cli)
          StringLit
            Text(raw=false) "logstat.bras"
          Ident(spec)
      Return
  Let top
    Catch(exhaustive=false, binding=e)
      Call
        Field(toInt)
          Coalesce
            Call
              Field(option)
                Ident(args)
              StringLit
                Text(raw=false) "top"
            StringLit
              Text(raw=false) "5"
      arm string.ParseError
          Int(5)
  Let classes
    MapLit
  Let paths
    MapLit
  Let clients
    MapLit
  Let failing
    MapLit
  Let mut total
    Int(0)
  Let mut skipped
    Int(0)
  Let mut bytes
    Int(0)
  For
    Binding(line)
    Call
      Field(lines)
        Call
          Ident(source)
          Field(rest)
            Ident(args)
    If
      cond
        Binary(==)
          Call
            Field(trim)
              Ident(line)
          StringLit
      then
        Continue
    Let caps
      Coalesce
        Call
          Field(captures)
            Ident(line)
          Ident(entryPattern)
        VectorLit
    If
      cond
        Binary(==)
          Call
            Field(len)
              Ident(caps)
          Int(0)
      then
        Assign +=
          Ident(skipped)
          Int(1)
        Continue
    Let client
      Index
        Ident(caps)
        Int(1)
    Let method
      Index
        Ident(caps)
        Int(2)
    Let path
      Index
        Call
          Field(split)
            Index
              Ident(caps)
              Int(3)
          StringLit
            Text(raw=false) "?"
        Int(0)
    Let status
      Index
        Ident(caps)
        Int(4)
    Assign +=
      Ident(total)
      Int(1)
    Assign +=
      Ident(bytes)
      Catch(exhaustive=false, binding=e)
        Call
          Field(toInt)
            Index
              Ident(caps)
              Int(5)
        arm string.ParseError
            Int(0)
    Call
      Field(bump)
        Ident(tally)
      Ident(classes)
      Binary(+)
        Call
          Field(slice)
            Ident(status)
          Int(0)
          Int(1)
        StringLit
          Text(raw=false) "xx"
    Call
      Field(bump)
        Ident(tally)
      Ident(paths)
      Ident(path)
    Call
      Field(bump)
        Ident(tally)
      Ident(clients)
      Ident(client)
    If
      cond
        Call
          Field(startsWith?)
            Ident(status)
          StringLit
            Text(raw=false) "5"
      then
        Call
          Field(bump)
            Ident(tally)
          Ident(failing)
          StringLit
            Interp
              Ident(method)
            Text(raw=false) " "
            Interp
              Ident(path)
  Call
    Ident(puts)
    StringLit
      Text(raw=false) "parsed "
      Interp
        Ident(total)
      Text(raw=false) " requests, skipped "
      Interp
        Ident(skipped)
      Text(raw=false) " unparsable lines"
  Call
    Ident(puts)
    StringLit
      Text(raw=false) "bytes served: "
      Interp
        Ident(bytes)
  Call
    Ident(puts)
    StringLit
  Call
    Ident(puts)
    StringLit
      Text(raw=false) "status classes:"
  For
    Binding(class)
    Call
      Field(sort)
        Call
          Field(keys)
            Ident(classes)
    Let hits
      Coalesce
        Index
          Ident(classes)
          Ident(class)
        Int(0)
    Call
      Ident(puts)
      StringLit
        Text(raw=false) "  "
        Interp
          Ident(class)
        Text(raw=false) "  "
        Interp
          Call
            Field(pad)
              Ident(tally)
            Ident(hits)
            Int(4)
        Text(raw=false) "  "
        Interp
          Call
            Ident(percent)
            Ident(hits)
            Ident(total)
  Call
    Ident(report)
    StringLit
      Text(raw=false) "top paths:"
    Call
      Field(ranked)
        Ident(tally)
      Ident(paths)
    Ident(top)
  Call
    Ident(report)
    StringLit
      Text(raw=false) "top clients:"
    Call
      Field(ranked)
        Ident(tally)
      Ident(clients)
    Ident(top)
  If
    cond
      Binary(==)
        Call
          Field(len)
            Ident(failing)
        Int(0)
    then
      Call
        Ident(puts)
        StringLit
      Call
        Ident(puts)
        StringLit
          Text(raw=false) "no server errors"
    else
      Call
        Ident(report)
        StringLit
          Text(raw=false) "server errors by endpoint:"
        Call
          Field(ranked)
            Ident(tally)
          Ident(failing)
        Call
          Field(len)
            Ident(failing)
