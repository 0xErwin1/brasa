      Call
        Field(asFloat)
          Index
            Ident(node)
            StringLit
              Text(raw=false) "utilization"
      Unary(-)
        Float(1)
  If
    cond
      Binary(>=)
        Ident(pct)
        Float(0)
    then
      Call
        Field(push)
          Ident(into)
        StructLit(provider.Window)
          field label
            Ident(label)
          field usedPercent
            Call
              Field(percent)
                Ident(provider)
              Ident(pct)
          field resetAt
            Coalesce
              Call
                Field(asString)
                  Index
                    Ident(node)
                    StringLit
                      Text(raw=false) "resets_at"
              StringLit
