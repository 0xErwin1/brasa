        Call
          Field(asFloat)
            Index
              Ident(doc)
              StringLit
                Text(raw=false) "credited"
        Unary(-)
          Float(1)
    field available
      Coalesce
        Call
          Field(asFloat)
            Index
              Ident(doc)
              StringLit
                Text(raw=false) "available"
        Unary(-)
          Float(1)
pub FuncDef advance(prior, available)
  If
    cond
      Binary(<)
        Field(credited)
          Ident(prior)
        Float(0)
    then
      Return
        StructLit(Ledger)
          field credited
            Ident(available)
          field available
            Ident(available)
  Let delta
    Binary(-)
      Ident(available)
      Field(available)
        Ident(prior)
  Let credited
    If
      cond
        Binary(>)
          Ident(delta)
          Ident(epsilon)
      then
        Binary(+)
          Field(credited)
            Ident(prior)
          Ident(delta)
      else
        Field(credited)
          Ident(prior)
  StructLit(Ledger)
    field credited
      Ident(credited)
    field available
      Ident(available)
