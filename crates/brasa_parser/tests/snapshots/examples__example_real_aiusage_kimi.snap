TestDef("a first run baselines, so an existing balance is not read as spend")
  Let fresh
    StructLit(Ledger)
      field credited
        Unary(-)
          Float(1)
      field available
        Unary(-)
          Float(1)
  Let after
    Call
      Ident(advance)
      Ident(fresh)
      Float(20)
  Call
    Ident(assertEq)
    Field(credited)
      Ident(after)
    Float(20)
  Call
    Ident(assertEq)
    Field(available)
      Ident(after)
    Float(20)
TestDef("a drop is consumption, so credited stays where it was")
