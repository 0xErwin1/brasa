# What a model costs, and which tier a raw model id belongs to.
#
# Split out because this is the only part that moves when a provider
# changes its price sheet: the scan and the report never read a rate.

# List prices per million tokens, one rate per counter a turn reports.
pub struct Price
  input: float
  output: float
  cacheWrite: float
  cacheRead: float
end

# Flat-rate subscription usage costs none of this, so everything priced
# here is what the same tokens would have cost on the API.
pub def forModel(model: string): Price
  let m = model.toLower()

  if m.contains?("opus")
    Price { input: 15.0, output: 75.0, cacheWrite: 18.75, cacheRead: 1.5 }
  elsif m.contains?("fable")
    Price { input: 10.0, output: 50.0, cacheWrite: 12.5, cacheRead: 1.0 }
  elsif m.contains?("haiku")
    Price { input: 0.8, output: 4.0, cacheWrite: 1.0, cacheRead: 0.08 }
  else
    Price { input: 3.0, output: 15.0, cacheWrite: 3.75, cacheRead: 0.3 }
  end
end

# Collapses a raw model id to its tier, matching `forModel`'s buckets.
# An unknown id keeps its raw string so it stays visible in the report
# instead of folding silently into the default price.
pub def label(model: string): string
  let m = model.toLower()

  if m.contains?("opus")
    "Opus"
  elsif m.contains?("fable")
    "Fable"
  elsif m.contains?("sonnet")
    "Sonnet"
  elsif m.contains?("haiku")
    "Haiku"
  else
    model
  end
end

# The four counters are priced differently and a caller that added them
# up first would lose the distinction, so the arithmetic lives with the
# rates rather than at the call site.
pub def usd(p: Price, inTok: int, outTok: int, writeTok: int, readTok: int): float
  (inTok.toFloat() * p.input + outTok.toFloat() * p.output + writeTok.toFloat() * p.cacheWrite + readTok.toFloat() * p.cacheRead) / 1000000.0
end
