#!/usr/bin/env brasa
# Summarize an nginx combined access log: how many requests came in, how
# many bytes went out, the status-class mix, the busiest paths and
# clients, and every endpoint that returned a server error.
#
#   brasa logstat.bras data/access.log
#   cat /var/log/nginx/access.log | brasa logstat.bras

import std::env
import std::fs
import std::io
import std::math
import "tally.bras"

let entryPattern = """^(\S+) \S+ \S+ \[[^\]]+\] "([A-Z]+) ([^ "]+)[^"]*" (\d{3}) (\d+|-)"""

# Reads the log from the first CLI argument, or from stdin when there is
# none, so the script works both as a file reader and as a pipe filter.
def source(): string
  let args = env.args()

  if args.len() == 0
    io.readAll()
  else
    fs.read(args[0])
  end
end

def percent(part: int, total: int): string
  let share = part.toFloat() / total.toFloat() * 100.0

  "#{share.toFixed(1)}%"
end

def report(title: string, rows: Vector<tally.Tally>, limit: int)
  puts ""
  puts title

  for i in 0..math.min(limit, rows.len())
    let row = rows[i]
    puts "  #{tally.pad(row.hits, 4)}  #{row.key}"
  end
end

def main()
  let classes: Map<string, int> = {}
  let paths: Map<string, int> = {}
  let clients: Map<string, int> = {}
  let failing: Map<string, int> = {}

  let mut total = 0
  let mut skipped = 0
  let mut bytes = 0

  for line in source().lines()
    if line.trim() == ""
      continue
    end

    let caps: Vector<string> = line.captures(entryPattern) ?? []

    if caps.len() == 0
      skipped += 1
      continue
    end

    let client = caps[1]
    let method = caps[2]
    let path = caps[3].split("?")[0]
    let status = caps[4]

    total += 1
    bytes += caps[5].toInt() catch (e)
      string.ParseError => 0
    end

    tally.bump(classes, status.slice(0, 1) + "xx")
    tally.bump(paths, path)
    tally.bump(clients, client)

    if status.startsWith?("5")
      tally.bump(failing, "#{method} #{path}")
    end
  end

  puts "parsed #{total} requests, skipped #{skipped} unparsable lines"
  puts "bytes served: #{bytes}"

  puts ""
  puts "status classes:"

  for class in classes.keys().sort()
    let hits = classes[class] ?? 0
    puts "  #{class}  #{tally.pad(hits, 4)}  #{percent(hits, total)}"
  end

  report("top paths:", tally.ranked(paths), 5)
  report("top clients:", tally.ranked(clients), 3)

  if failing.len() == 0
    puts ""
    puts "no server errors"
  else
    report("server errors by endpoint:", tally.ranked(failing), failing.len())
  end
end
